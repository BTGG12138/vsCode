<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- gz-sim 传感器定义（激光雷达 + 深度相机 + RGB 相机）。
       要点：
       1. 雷达必须用 gpu_lidar 类型（渲染型），classic 的 ray 类型在 gz-sim 不产生数据。
       2. 深度相机用 rgbd_camera 类型，会发布 <topic>/image、<topic>/depth_image、
          <topic>/points、<topic>/camera_info。
       3. 传感器坐标系用 <frame_id>（<frame_name> 是 classic gazebo 写法，gz-sim 会忽略），
          取值必须与 URDF 里的 link 名一致，rviz 才能通过 TF 树对齐。
       4. 话题名必须用绝对名（以 / 开头），且 bridge 两侧要一致。
       5. 传感器数据由世界文件里的 gz-sim-sensors-system 插件驱动（见 living_room.sdf）。-->
  <xacro:macro name="sensor_plugin">
    <!-- 激光雷达 -->
    <gazebo reference="laser">
      <sensor name="laser" type="gpu_lidar">
        <topic>/scan</topic>
        <frame_id>laser</frame_id>
        <update_rate>20</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1.0</resolution>
              <min_angle>-3.1415926</min_angle>
              <max_angle>3.1415926</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>8.0</max>
            <resolution>0.015</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>

    <!-- 深度相机 camera01：rgbd_camera，输出彩色图 + 深度图 + 点云 -->
    <gazebo reference="camera01_link">
      <sensor name="depth_camera" type="rgbd_camera">
        <topic>/depth_camera</topic>
        <frame_id>camera01_link</frame_id>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.5009831567</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>12.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>

    <!-- RGB 相机 camera02 -->
    <gazebo reference="camera02_link">
      <sensor name="camera02" type="camera">
        <topic>/camera02/image_raw</topic>
        <frame_id>camera02_link</frame_id>
        <update_rate>40</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.5009831567</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>12.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
