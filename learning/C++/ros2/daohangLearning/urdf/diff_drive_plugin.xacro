<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- gz-sim 差速插件。
       注意：URDF 里 gz-sim 扩展标签是 <gazebo>（不是 <gz>），
       sdformat 的 URDF 解析器只认 <gazebo>，写 <gz> 会被静默丢弃导致插件不加载。
       wheel01 在 y=+0.1 为左侧轮，wheel02 在 y=-0.1 为右侧轮。
       topic 必须用绝对名(带/)，相对名会被插件忽略并回退到 /model/<name>/cmd_vel，
       与 ros_gz_bridge 桥接的 /cmd_vel 对不上。-->
  <xacro:macro name="diff_drive_plugin">
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>wheel01_joint</left_joint>
        <right_joint>wheel02_joint</right_joint>
        <wheel_separation>0.2</wheel_separation>
        <wheel_radius>0.04</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_publish_frequency>30</odom_publish_frequency>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <!-- 差速里程计积分的是轮轴中点在地面上的投影点，即 base_footprint -->
        <child_frame_id>base_footprint</child_frame_id>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
