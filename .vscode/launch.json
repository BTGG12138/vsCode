{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ 调试 (无终端输入 - 清爽版)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb", // Ubuntu 默认的 gdb 路径
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: g++ 生成活动文件", // 对应 tasks.json 里的 label
            "console": "internalConsole"             // 【关键】使用 VS Code 内部的控制台
        }
    ]
}